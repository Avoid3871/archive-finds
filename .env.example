# ==========================================
# ARCHIVE FINDS - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/archive_finds"

# 2. SUGARGOO AFFILIATE ENGINE
SUGARGOO_MEMBER_ID="archivefinds"

# 3. GOOGLE SHEETS API (Optional, public CSV export used by default)
GOOGLE_SHEETS_API_KEY=""

# 4. LOCAL WORKER CONFIGURATION
PYTHON_PATH="python"
STORAGE_BASE_DIR="./storage/products"
WORKER_PORT=3001

# 5. PUBLIC WEB APP
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
